# Port the API listens on
PORT=4000

# PostgreSQL connection string (matches docker-compose.yml defaults)
DATABASE_URL=postgres://doomsday:doomsday@localhost:5433/doomsday

# Separate database used by the integration test suite
TEST_DATABASE_URL=postgres://doomsday:doomsday@localhost:5433/doomsday_test

# Comma-separated list of origins allowed to call the API (the Vite dev server by default)
CORS_ORIGIN=http://localhost:5173

# Optional: TMDb credentials (https://www.themoviedb.org/settings/api).
# Accepts either the v3 "API Key" or the v4 "API Read Access Token".
# Enables movie search, poster images and runtime autofill.
# Leave empty to run without TMDb; every required feature works without it.
TMDB_API_KEY=

# Look up posters and details from TVMaze and Wikipedia (and TMDb when a key is set).
# No key needed. Set to false to make no external requests.
METADATA_LOOKUPS=true
