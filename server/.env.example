# Port the API listens on
PORT=4000

# PostgreSQL connection string (matches docker-compose.yml defaults)
DATABASE_URL=postgres://doomsday:doomsday@localhost:5432/doomsday

# Separate database used by the integration test suite
TEST_DATABASE_URL=postgres://doomsday:doomsday@localhost:5432/doomsday_test

# Comma-separated list of origins allowed to call the API (the Vite dev server by default)
CORS_ORIGIN=http://localhost:5173

# Optional: TMDb API Read Access Token (v4). Enables poster + metadata lookup.
# Leave empty to run without TMDb; the app is fully functional without it.
TMDB_API_TOKEN=
